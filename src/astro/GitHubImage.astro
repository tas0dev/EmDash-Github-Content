---
interface Props {
  value: {
    url?: string;
    alt?: string;
    caption?: string;
  };
}

const { value } = Astro.props;
---

<figure class="github-content-image">
  {value.url && <img src={value.url} alt={value.alt ?? ""} loading="lazy" />}
  {value.caption && <figcaption>{value.caption}</figcaption>}
</figure>

<style>
  .github-content-image {
    margin: 1.75rem 0;
  }

  .github-content-image img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  .github-content-image figcaption {
    margin-top: 0.5rem;
    color: var(--ink-secondary, #666);
    font-size: 0.875rem;
  }
</style>
